# ============================================================
# Copiá este archivo como ".env" y completá cada valor.
# En Railway/Render estos mismos valores se cargan como
# "Variables" en el panel del servicio (sin archivo .env).
# ============================================================

# --- WhatsApp (de developers.facebook.com) ---

# Token de acceso. Para probar: el token temporal (dura 24 hs) que
# aparece en "API Setup". Para producción: un token permanente de
# System User (paso 8 del README).
WHATSAPP_TOKEN=

# "Phone number ID" que aparece en API Setup (NO es tu número de
# teléfono, es un ID numérico largo).
WHATSAPP_PHONE_NUMBER_ID=

# Una contraseña que inventás VOS. Tiene que ser exactamente la misma
# acá y en el campo "Verify token" al configurar el webhook en Meta.
WHATSAPP_VERIFY_TOKEN=elegi-una-clave-secreta

# --- Inteligencia artificial (de platform.claude.com) ---
ANTHROPIC_API_KEY=

# Modelo a usar. Haiku es el más barato y sobra para atención al cliente.
CLAUDE_MODEL=claude-haiku-4-5

# --- Personalización del asistente ---
BOT_NAME=ASISTIX
BUSINESS_NAME=Mi Negocio

# Puerto local (Railway/Render lo setean solos)
PORT=3000
